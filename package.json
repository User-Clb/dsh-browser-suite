{
  "name": "dsh-browser-suite",
  "version": "0.3.5",
  "description": "DSH 浏览器套件：本地搜索与抓取、输入框本地/API 切换、网页版 DeepSeek 桥接与自动对话源。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/User-Clb/dsh-browser-suite.git"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.cjs",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "web-search",
    "deepseek-web",
    "dom-automation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
